# Server Config
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite+aiosqlite:///./researchmind.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/researchmind

# Security
SECRET_KEY=super-secret-key-change-in-production-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Config (OpenAI / Gemini / Anthropic)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Live Search API (Optional: Tavily API key or fallback to DuckDuckGo)
TAVILY_API_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
